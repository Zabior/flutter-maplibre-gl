<?xml version="1.0" encoding="utf-8"?>
<!-- Stands in for every user location indicator image while
     myLocationIndicatorVisible is false: the location component keeps running
     and draws nothing. The size is required, the SDK rasterizes drawables at
     their intrinsic size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
